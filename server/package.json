{
  "name": "achats-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "build:exe": "npm run build && pkg . --targets node22-win-x64 --output ../release/AchatsContrats.exe --public-packages \"*\" --public"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@yao-pkg/pkg": "^6.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "pkg": {
    "assets": [
      "../client/dist/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "../release",
    "public": true
  }
}
